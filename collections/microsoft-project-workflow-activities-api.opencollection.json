{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Project Online REST Assignments Workflow Activities API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflow Activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Project List Workflow Activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.sharepoint.com/sites/pwa/_api/ProjectServer/WorkflowActivities"
          },
          "docs": "Retrieve all workflow activities."
        }
      ]
    }
  ],
  "bundled": true
}